diff --git a/src/db.c b/src/db.c
index 2875a35..4420150 100644
--- a/src/db.c
+++ b/src/db.c
@@ -14,6 +14,19 @@ DbStatus db_insert(Table *table, uint32_t id, const char *name) {
     if (db_save(table) != 0) { --table->count; return DB_IO_ERROR; }
     return DB_OK;
 }
+DbStatus db_delete(Table *table, uint32_t id) {
+    uint32_t index = 0;
+    while (index < table->count && table->rows[index].id != id) ++index;
+    if (index == table->count) return DB_NOT_FOUND;
+    Table next = *table;
+    for (uint32_t i = index; i + 1 < next.count; ++i)
+        next.rows[i] = next.rows[i + 1];
+    --next.count;
+    memset(&next.rows[next.count], 0, sizeof next.rows[next.count]);
+    if (db_save(&next) != 0) return DB_IO_ERROR;
+    *table = next;
+    return DB_OK;
+}
 void db_select(const Table *table) {
     for (uint32_t i = 0; i < table->count; ++i)
         printf("(%u, %s)\n", (unsigned)table->rows[i].id, table->rows[i].name);
