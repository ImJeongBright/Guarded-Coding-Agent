 Build the fixed C11 source list into `build/minidb`; tests are process-level and store temporary
 database files under `build/test-data`. The on-disk GDB1 format is intentionally stable.
 
-Supported commands: `insert <uint32 id> <name>`, `delete <uint32 id>`, `rename <uint32 id> <new-name>`, `find <uint32 id>`, `select`, `count`, `clear`, `.help`, `.exit`.
+Stats takes no arguments and prints exactly `Rows: <count>/100` followed by
+`Available: <100-count>` on the next line. It is read-only: repeated calls and
+restarts preserve database bytes, and an empty workspace stays file-free.
+Extra arguments print `Error: invalid statement.` without changing state.
+
+Supported commands: `insert <uint32 id> <name>`, `delete <uint32 id>`, `rename <uint32 id> <new-name>`, `find <uint32 id>`, `select`, `count`, `stats`, `clear`, `.help`, `.exit`.
 
 Delete removes the matching row while preserving the order of all remaining rows.
 Ids range from 0 to 4294967295. A successful delete prints `Executed.`; a missing
diff --git a/src/command.c b/src/command.c
index d7fd091..4a99af8 100644
--- a/src/command.c
+++ b/src/command.c
@@ -25,7 +25,14 @@ static void print_status(DbStatus status) {
 int command_dispatch(Table *table, const char *line) {
     if (strcmp(line, ".exit") == 0) return 1;
     if (strcmp(line, ".help") == 0) {
-        puts("insert <uint32 id> <name>; delete <uint32 id>; rename <uint32 id> <new-name>; find <uint32 id>; select; count; clear; .exit"); return 0;
+        puts("insert <uint32 id> <name>; delete <uint32 id>; rename <uint32 id> <new-name>; find <uint32 id>; select; count; stats; clear; .exit"); return 0;
+    }
+    if (strcmp(line, "stats") == 0) {
+        uint32_t count = db_count(table);
+        uint32_t capacity = db_capacity();
+        printf("Rows: %u/%u\nAvailable: %u\n",
+               (unsigned)count, (unsigned)capacity, (unsigned)(capacity - count));
+        return 0;
     }
     if (strcmp(line, "clear") == 0) { print_status(db_clear(table)); return 0; }
     if (strcmp(line, "select") == 0) { db_select(table); return 0; }
