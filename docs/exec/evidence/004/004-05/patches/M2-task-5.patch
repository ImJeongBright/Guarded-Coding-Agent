diff --git a/tests/test_db.py b/tests/test_db.py
index dd1c973..3086c61 100644
--- a/tests/test_db.py
+++ b/tests/test_db.py
@@ -378,5 +378,93 @@ class DatabaseTests(unittest.TestCase):
         self.assertEqual(result.stdout,'Executed.\nCount: 0\nExecuted.\n')
         self.assertEqual(database.read_bytes(),b'GDB1'+struct.pack('<I',0))
 
+
+    def test_stats_new_workspace_repeated_and_restart(self):
+        for _ in range(2):
+            result=self.run_db('stats\nstats\n.exit\n')
+            self.assertEqual(result.returncode,0)
+            self.assertEqual(result.stderr,'')
+            self.assertEqual(result.stdout,'Rows: 0/100\nAvailable: 100\n'*2)
+            self.assertEqual(list(self.path.iterdir()),[])
+
+    def test_stats_existing_empty_database(self):
+        database=self.path/'data.db'
+        data=b'GDB1'+struct.pack('<I',0)
+        database.write_bytes(data)
+        before=database.stat()
+        for _ in range(2):
+            result=self.run_db('stats\nstats\n')
+            self.assertEqual(result.returncode,0)
+            self.assertEqual(result.stdout,'Rows: 0/100\nAvailable: 100\n'*2)
+            self.assertEqual(database.read_bytes(),data)
+            self.assertEqual(database.stat().st_mtime_ns,before.st_mtime_ns)
+            self.assertEqual(database.stat().st_ino,before.st_ino)
+            self.assertEqual([p.name for p in self.path.iterdir()],['data.db'])
+
+    def test_stats_populated_repeated_restart_preserves_bytes(self):
+        # Preserve noncanonical padding to detect an accidental save.
+        data=(b'GDB1'+struct.pack('<I',2)
+              +struct.pack('<I',7)+b'seven\0'+b'x'*26
+              +struct.pack('<I32s',0,b'zero'))
+        database=self.path/'data.db'
+        database.write_bytes(data)
+        before=database.stat()
+        for _ in range(2):
+            result=self.run_db('stats\nstats\nfind 7\ncount\n')
+            self.assertEqual(result.returncode,0)
+            self.assertEqual(result.stdout,
+                             'Rows: 2/100\nAvailable: 98\n'*2
+                             +'(7, seven)\nCount: 2\n')
+            self.assertEqual(database.read_bytes(),data)
+            self.assertEqual(database.stat().st_mtime_ns,before.st_mtime_ns)
+            self.assertEqual(database.stat().st_ino,before.st_ino)
+            self.assertEqual([p.name for p in self.path.iterdir()],['data.db'])
+
+    def test_stats_full_table_and_restart(self):
+        result=self.run_db(''.join(f'insert {i} row{i}\n' for i in range(100))
+                           +'stats\n')
+        self.assertEqual(result.returncode,0)
+        self.assertEqual(result.stdout,'Executed.\n'*100+'Rows: 100/100\nAvailable: 0\n')
+        database=self.path/'data.db'
+        before=database.read_bytes()
+        for _ in range(2):
+            result=self.run_db('stats\nstats\n')
+            self.assertEqual(result.returncode,0)
+            self.assertEqual(result.stdout,'Rows: 100/100\nAvailable: 0\n'*2)
+            self.assertEqual(database.read_bytes(),before)
+            self.assertFalse((self.path/'data.db.tmp').exists())
+
+    def test_stats_malformed_arguments_preserve_state(self):
+        invalid=['stats 0','stats extra','stats extra more','stats\textra',
+                 'stats '+'x'*100]
+        for populated in (False,True):
+            if populated:
+                self.assertEqual(self.run_db('insert 0 zero\n').returncode,0)
+            database=self.path/'data.db'
+            before=database.read_bytes() if populated else None
+            for _ in range(2):
+                result=self.run_db('\n'.join(invalid)+'\nstats\nselect\n.help\n')
+                self.assertEqual(result.returncode,0)
+                self.assertEqual(result.stdout.splitlines()[:-1],
+                                 ['Error: invalid statement.']*len(invalid)
+                                 +(['Rows: 1/100','Available: 99','(0, zero)','Executed.']
+                                   if populated else ['Rows: 0/100','Available: 100','Executed.']))
+                self.assertIn('; stats;',result.stdout)
+                if populated:
+                    self.assertEqual(database.read_bytes(),before)
+                else:
+                    self.assertEqual(list(self.path.iterdir()),[])
+                self.assertFalse((self.path/'data.db.tmp').exists())
+
+    def test_stats_tracks_mutations(self):
+        result=self.run_db('insert 7 seven\nstats\nrename 7 new\nstats\n'
+                           'find 7\ndelete 7\nstats\ninsert 0 zero\nclear\nstats\n')
+        self.assertEqual(result.returncode,0)
+        self.assertEqual(result.stdout.splitlines(),[
+            'Executed.','Rows: 1/100','Available: 99','Executed.',
+            'Rows: 1/100','Available: 99','(7, new)','Executed.',
+            'Rows: 0/100','Available: 100','Executed.','Executed.',
+            'Rows: 0/100','Available: 100'])
+
 if __name__=='__main__':
     unittest.main(verbosity=2)
