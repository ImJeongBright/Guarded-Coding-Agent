diff --git a/src/db.c b/src/db.c
index f2a550e..1e884a3 100644
--- a/src/db.c
+++ b/src/db.c
@@ -27,6 +27,17 @@ DbStatus db_delete(Table *table, uint32_t id) {
     *table = next;
     return DB_OK;
 }
+DbStatus db_rename(Table *table, uint32_t id, const char *name) {
+    uint32_t index = 0;
+    while (index < table->count && table->rows[index].id != id) ++index;
+    if (index == table->count) return DB_NOT_FOUND;
+    Table next = *table;
+    memset(next.rows[index].name, 0, NAME_BYTES);
+    memcpy(next.rows[index].name, name, strlen(name));
+    if (db_save(&next) != 0) return DB_IO_ERROR;
+    *table = next;
+    return DB_OK;
+}
 const Row *db_find(const Table *table, uint32_t id) {
     for (uint32_t i = 0; i < table->count; ++i)
         if (table->rows[i].id == id) return &table->rows[i];
