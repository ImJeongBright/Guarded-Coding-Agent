diff --git a/src/db.c b/src/db.c
index 1e884a3..cd0528b 100644
--- a/src/db.c
+++ b/src/db.c
@@ -27,6 +27,16 @@ DbStatus db_delete(Table *table, uint32_t id) {
     *table = next;
     return DB_OK;
 }
+DbStatus db_clear(Table *table) {
+    if (table->count == 0) return DB_OK;
+    uint32_t original_count = table->count;
+    table->count = 0;
+    if (db_save(table) != 0) {
+        table->count = original_count;
+        return DB_IO_ERROR;
+    }
+    return DB_OK;
+}
 DbStatus db_rename(Table *table, uint32_t id, const char *name) {
     uint32_t index = 0;
     while (index < table->count && table->rows[index].id != id) ++index;
