+test('forecast classification preserves finite thresholds and returns null for unknown changes', () => {
+  for (const key of ['S&P 500', 'NASDAQ-100', 'Broad U.S. Dollar Index', 'US 10Y Treasury yield']) {
+    const threshold = key.includes('10Y') ? 1 : 0.05;
+    for (const [change, expected] of [
+      [-threshold - 0.001, 'down'], [-threshold, 'flat'], [-threshold / 2, 'flat'],
+      [-0, 'flat'], [0, 'flat'], [threshold / 2, 'flat'], [threshold, 'flat'],
+      [threshold + 0.001, 'up'], [-Number.MAX_VALUE, 'down'], [Number.MAX_VALUE, 'up'],
+    ]) {
+      assert.equal(directionForChange(change, key), expected, `${key}: ${change}`);
+    }
+    for (const change of [null, undefined, NaN, Infinity, -Infinity]) {
+      assert.equal(directionForChange(change, key), null);
+    }
+  }
+});
+
+test('forecast unknown actual changes withhold prediction points while preserving known results', () => {
+  const predictions = { 'S&P 500': 'down', 'NASDAQ-100': 'down', 'US 10Y Treasury yield': 'up', 'Broad U.S. Dollar Index': 'up' };
+  const input = { marketIndex: 0, predictions, reason: '', action: 'defensive', openedSources: 0, actualChanges };
+  const known = evaluateDecision(input);
+  assert.deepEqual(known.score, { evidence: 0, causality: 0, prediction: 5, action: 25, uncertainty: 0, total: 30 });
+  assert.deepEqual(known.forecasts.map(item => [item.actual, item.correct]), [
+    ['down', true], ['down', true], ['up', true], ['up', true],
+  ]);
+  for (const key of Object.keys(actualChanges)) {
+    for (const change of [null, undefined, NaN, Infinity, -Infinity]) {
+      const feedback = evaluateDecision({ ...input, actualChanges: { ...actualChanges, [key]: change } });
+      assert.deepEqual(feedback.score, { ...known.score, prediction: 0, total: 25 });
+      assert.deepEqual(feedback.forecasts, known.forecasts.map(item =>
+        item.key === key ? { ...item, actual: null, correct: null } : item));
+    }
+    const missing = { ...actualChanges };
+    delete missing[key];
+    const feedback = evaluateDecision({ ...input, actualChanges: missing });
+    assert.equal(feedback.score.prediction, 0);
+    assert.deepEqual(feedback.forecasts, known.forecasts.map(item =>
+      item.key === key ? { ...item, actual: null, correct: null } : item));
+  }
+});
