[
  "$HOME/.nvm/versions/node/v24.20.0/bin/codex",
  "exec",
  "--ignore-user-config",
  "--ignore-rules",
  "--ephemeral",
  "--strict-config",
  "--skip-git-repo-check",
  "--sandbox",
  "read-only",
  "--json",
  "-C",
  "$RUN/workspace",
  "--dangerously-bypass-hook-trust",
  "-c",
  "approval_policy=\"never\"",
  "-c",
  "sandbox_mode=\"read-only\"",
  "-c",
  "web_search=\"disabled\"",
  "-c",
  "features={\"hooks\" = true, \"shell_tool\" = false, \"unified_exec\" = false, \"multi_agent\" = false, \"multi_agent_v2\" = false, \"apps\" = false, \"plugins\" = false, \"browser_use\" = false, \"browser_use_external\" = false, \"computer_use\" = false, \"in_app_browser\" = false, \"image_generation\" = false, \"code_mode\" = false, \"code_mode_only\" = false, \"view_image\" = false, \"shell_snapshot\" = false, \"skill_mcp_dependency_install\" = false, \"tool_suggest\" = false}",
  "-c",
  "log_dir=\"$RUN/state/host-logs\"",
  "-c",
  "sqlite_home=\"$RUN/state/host-db\"",
  "-c",
  "history={\"persistence\" = \"none\"}",
  "-c",
  "mcp_servers={\"guard\" = {\"command\" = \"/Library/Frameworks/Python.framework/Versions/3.12/bin/python3\", \"args\" = [\"$REPO/scripts/guard_stdio.py\", \"serve\", \"--workspace\", \"$RUN/workspace\", \"--state\", \"$RUN/state\", \"--policy\", \"$RUN/state/policy.json\"], \"required\" = true, \"enabled_tools\" = [\"guard_filesystem\", \"guard_shell\", \"guard_git\"], \"default_tools_approval_mode\" = \"approve\", \"tool_timeout_sec\" = 130}}",
  "-c",
  "hooks={\"PreToolUse\" = [{\"matcher\" = \".*\", \"hooks\" = [{\"type\" = \"command\", \"command\" = \"/Library/Frameworks/Python.framework/Versions/3.12/bin/python3 $REPO/scripts/codex_pre_tool.py\", \"timeout\" = 5}]}]}",
  "-c",
  "hooks={\"PreToolUse\" = [{\"matcher\" = \".*\", \"hooks\" = [{\"type\" = \"command\", \"command\" = \"$RUN/state/nonexistent-hook\", \"timeout\" = 1}]}]}"
]
