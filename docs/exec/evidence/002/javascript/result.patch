+const { parseRecord, stringifyRecord } = require("./csv.cjs");
+
+test("plain, empty, and trailing fields", () => {
+  assert.deepEqual(parseRecord("a,,c,"), ["a", "", "c", ""]);
+  assert.deepEqual(parseRecord(""), [""]);
+  assert.deepEqual(parseRecord('""'), [""]);
+  assert.deepEqual(parseRecord(","), ["", ""]);
+});
+
+test("quoted commas and doubled quotes", () => {
+  assert.deepEqual(parseRecord('a,"b,c",d'), ["a", "b,c", "d"]);
+  assert.deepEqual(parseRecord('"a""b"'), ['a"b']);
+  assert.deepEqual(parseRecord('"""","a,""b""",'), ['"', 'a,"b"', ""]);
+});
+
+test("spaces are preserved exactly", () => {
+  assert.deepEqual(parseRecord(' a ," b ",  ,'), [" a ", " b ", "  ", ""]);
+  assert.equal(stringifyRecord([" a ", " b,c ", "  "]), ' a ," b,c ",  ');
+});
+
+test("malformed quotes throw Error", () => {
+  for (const record of ['"', '"abc', '"a""', 'a"b', ' "a"', '"a"x', '"a" ', '"a"\t', 'a,"b"c', 'a,b"']) {
+    assert.throws(() => parseRecord(record), Error, JSON.stringify(record));
+  }
+});
+
+test("records reject nonstrings and every CR/LF location", () => {
+  for (const record of [null, undefined, 1, [], {}, "a\nb", "a\rb", '"a\nb"', '"a\rb"', "a\r\n"]) {
+    assert.throws(() => parseRecord(record), Error);
+  }
+});
+
+test("stringify escapes commas and quotes", () => {
+  assert.equal(stringifyRecord(["a", "b,c", 'd"e', ""]), 'a,"b,c","d""e",');
+  assert.equal(stringifyRecord([""]), "");
+  assert.equal(stringifyRecord(['"']), '""""');
+});
+
+test("stringify rejects invalid arrays and fields", () => {
+  for (const fields of [[], null, undefined, "abc", {}, [1], [null], [undefined], [true], [{}], [["a"]], ["ok", 1], new Array(1), ["a\nb"], ["a\rb"], ["\r\n"]]) {
+    assert.throws(() => stringifyRecord(fields), Error);
+  }
+});
+
+test("parse/stringify roundtrip across field combinations", () => {
+  const values = ["", "a", " ", " a ", ",", '"', 'a,"b"', "\t", "한글", "😀"];
+  for (const a of values) {
+    assert.deepEqual(parseRecord(stringifyRecord([a])), [a]);
+    for (const b of values) {
+      for (const c of values) {
+        const fields = [a, b, c];
+        assert.deepEqual(parseRecord(stringifyRecord(fields)), fields);
+      }
+    }
+  }
+});
